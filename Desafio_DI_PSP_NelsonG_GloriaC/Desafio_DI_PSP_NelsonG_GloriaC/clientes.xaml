<Window x:Class="Desafio_DI_PSP_NelsonG_GloriaC.clientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Clientes" Height="450" Width="750"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Listado de Clientes" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Recargar Datos" Width="110" Height="30" Click="BtnRecargar_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgClientes"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Background="#FFF0F5"
                  AlternatingRowBackground="#FFE4E1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Usuario" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="NIF" Binding="{Binding Nif}" Width="100"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="90"/>
                <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="txtEstadoClientes" Grid.Row="3" Margin="0,10,0,0" Foreground="Gray"/>
    </Grid>
</Window>