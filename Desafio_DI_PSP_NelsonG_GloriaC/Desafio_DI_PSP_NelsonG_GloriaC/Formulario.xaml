<Window x:Class="Desafio_DI_PSP_NelsonG_GloriaC.Formulario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Cliente - Formulario" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="Datos del Cliente" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

        <!-- Campos del formulario -->
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <Label Content="ID de Usuario:"/>
            <TextBox x:Name="txtIdUsuario" Height="25" Margin="0,0,0,10"/>

            <Label Content="Nombre completo:"/>
            <TextBox x:Name="txtNombre" Height="25" Margin="0,0,0,10"/>

            <Label Content="NIF:"/>
            <TextBox x:Name="txtNif" Height="25" Margin="0,0,0,10"/>

            <Label Content="Email:"/>
            <TextBox x:Name="txtEmail" Height="25" Margin="0,0,0,10"/>

            <Label Content="Teléfono:"/>
            <TextBox x:Name="txtTelefono" Height="25" Margin="0,0,0,10"/>

            <Label Content="Dirección:"/>
            <TextBox x:Name="txtDireccion" Height="25" Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Botones de Acción -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Guardar" Width="90" Height="30" Margin="0,0,10,0" Click="BtnGuardar_Click"/>
            <Button Content="Cancelar" Width="90" Height="30" Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>